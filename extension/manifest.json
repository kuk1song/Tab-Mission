{
  "name": "__MSG_appName__",
  "short_name": "Tab Mission",
  "description": "__MSG_appDescription__",
  "version": "2.0.1",
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "author": {
    "name": "Haokun Song",
    "email": "shk741612898@gmail.com"
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "favicon",
    "scripting",
    "system.display",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-overview": {
      "description": "__MSG_commandOpen__",
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+E"
      }
    },
    "open-overview-site": {
      "description": "__MSG_commandOpenSite__"
    }
  }
}
